  @@index([type])
  @@index([inventoryItemId])
}

// --- LOGISTICS TICKET SYSTEM ---
enum LogisticsTicketType {
  BATCH_PACKING
  MATERIAL_PICKING
  WARRANTY_MATERIAL
}

enum LogisticsTicketStatus {
  PENDING
  PICKING
  PACKED
  COMPLETED
  CANCELLED
}

model LogisticsTicket {
  id     String                @id @default(cuid())
  code   String                @unique // Mã phiếu (VD: PK-20260728-001)
  type   LogisticsTicketType
  status LogisticsTicketStatus @default(PENDING)

  // Relations to source documents
  saleOrderId    String?
  saleOrder      SaleOrder?    @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  defectRecordId String?
  defectRecord   DefectRecord? @relation(fields: [defectRecordId], references: [id], onDelete: SetNull)
  // productionPlanId String? // Có thể thêm Lệnh sản xuất sau

  // Assignments
  assignedToId String?
  assignedTo   Employee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  items LogisticsTicketItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([type])
  @@index([status])
  @@index([saleOrderId])
  @@index([defectRecordId])
  @@index([assignedToId])
}

model LogisticsTicketItem {
  id String @id @default(cuid())

  ticketId String
  ticket   LogisticsTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  requestedQty Float @default(0) // Số lượng yêu cầu (Từ Đơn hàng/Định mức)
  pickedQty    Float @default(0) // Số lượng thực tế nhân viên đã nhặt

  reservations InventoryReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([inventoryItemId])
}

model InventoryReservation {
  id String @id @default(cuid())

  ticketItemId String
  ticketItem   LogisticsTicketItem @relation(fields: [ticketItemId], references: [id], onDelete: Cascade)

  inventoryStockId String
  inventoryStock   InventoryStock @relation(fields: [inventoryStockId], references: [id], onDelete: Cascade)

  reservedQty Float @default(0) // Số lượng đang bị giữ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketItemId])
  @@index([inventoryStockId])
}

// Cấu hình danh mục tiêu chí KPI
model InternalKpiCriteria {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  code        String?  // Mã tiêu chí (nếu có)
  name        String   // Tên tiêu chí đánh giá
  type        String   // Loại: "MANAGER" (Lãnh đạo phòng) hoặc "STAFF" (Nhân viên)
  targetValue Float    // Chỉ tiêu mục tiêu (VD: 8000000000)
  weight      Float    // Trọng số (VD: 30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  details     InternalKpiReportDetail[]
}

// Báo cáo tổng quan KPI hàng tháng
model InternalKpiReport {
  id          String   @id @default(cuid())
  month       Int      // Tháng (1-12)
  year        Int      // Năm
  employeeId  String?  // Tham chiếu ID nhân viên (nếu có)
  type        String   // "MANAGER" hoặc "STAFF"
  totalScore  Float    // Tổng điểm hiệu suất
  status      String   @default("DRAFT") // Trạng thái: DRAFT, PUBLISHED (Ban hành)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  details     InternalKpiReportDetail[]
  
  employee    Employee? @relation(fields: [employeeId], references: [id])
}

// Chi tiết điểm KPI từng tiêu chí trong tháng
model InternalKpiReportDetail {
  id             String      @id @default(cuid())
  reportId       String
  criteriaId     String
  targetValue    Float       // Chỉ tiêu tại thời điểm làm báo cáo
  actualValue    Float       // Thực tế đạt được
  weight         Float       // Trọng số tại thời điểm làm báo cáo
  score          Float       // Điểm số tính được
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  report         InternalKpiReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  criteria       InternalKpiCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
}

// Báo cáo Khung thu nhập
model InternalIncomeReport {
  id               String   @id @default(cuid())
  month            Int
  year             Int
  employeeId       String?  
  type             String   // "MANAGER" hoặc "STAFF"
  
  baseSalary       Float    @default(0) // Lương cơ bản
  performanceBonus Float    @default(0) // Lương hiệu suất
  allowance        Float    @default(0) // Phụ cấp
  salesCommission  Float    @default(0) // Hoa hồng bán hàng
  totalIncome      Float    @default(0) // Tổng thu nhập
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  employee         Employee? @relation(fields: [employeeId], references: [id])
}

model PaymentNotification {
  id              String      @id @default(cuid())
  code            String?     @unique
  amount          Float
  paymentMethod   String      @default("transfer") // transfer, cash
  note            String?
  status          String      @default("pending") // pending, verified, rejected
  saleOrderId     String?
  saleOrder       SaleOrder?  @relation(fields: [saleOrderId], references: [id])
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  reportedById    String?
  reportedBy      User?       @relation("ReportedPayments", fields: [reportedById], references: [id])
  verifiedById    String?
  verifiedBy      User?       @relation("VerifiedPayments", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  imageUrl        String?     // Screenshot
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Revenue {
  id          String   @id @default(cuid())
  amount      Float
  source      String?  // Nguồn doanh thu (VD: Bán hàng, Dịch vụ)
  referenceId String?  // ID tham chiếu (VD: Mã đơn hàng)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DealerSupportTicket {
  id              String    @id @default(cuid())
  code            String    @unique
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealerName      String?
  type            String    // Bảo hành & Linh kiện, Hỗ trợ catalog & POSM, Cấp phát vật tư & phụ kiện, Hỗ trợ đơn hàng & giao nhận, Đối soát công nợ & điểm thưởng, Xin cơ chế giá dự án / công trình
  orderCode       String?   // Mã đơn hàng liên quan
  priority        String    @default("normal") // normal, urgent
  title           String
  content         String?
  responseContent String?   // Nội dung phản hồi từ Phòng Kinh doanh
  status          String    @default("Pending") // Draft, Pending, In Progress, Resolved, Cancelled
  requestDate     DateTime  @default(now())
  resolvedAt      DateTime? // Thời điểm Phòng Kinh doanh xử lý hoàn tất
  handlerId       String?
  handler         Employee? @relation("DealerTicketHandler", fields: [handlerId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([customerId])
  @@index([handlerId])
  @@index([status])
}
