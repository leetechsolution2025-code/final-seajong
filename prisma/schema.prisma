  maturityDate       DateTime? // Ngày đáo hạn
  
  interestRate       Float?    // Lãi suất %/năm
  interestType       String?   // co_dinh, tha_noi
  repaymentMethod    String?   // goc_deu_lai_giam, tra_gop_deu, lai_hang_thang_goc_cuoi_ky
  purpose            String?   // Mục đích giải ngân
  
  status             String    @default("UNPAID") // UNPAID, PARTIAL, PAID
  paidPrincipal      Float     @default(0) // Dư nợ gốc đã trả
  paidInterest       Float     @default(0) // Lãi đã trả
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([bankLoanId])
  @@index([status])
}

