  startDate        DateTime? // Ngày bắt đầu hạn mức
  maturityDate     DateTime? // Ngày hết hạn hạn mức

  // Thông tin thêm cho Vay thế chấp
  collateralType  String? // Bất động sản, máy móc...
  collateralValue Float? // Giá trị định giá
  ltvRatio        Float? // Tỷ lệ cho vay / Giá trị (%)

  // Trạng thái theo dõi
  status             String @default("ACTIVE") // ACTIVE, CLOSED, OVERDUE

